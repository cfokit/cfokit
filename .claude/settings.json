{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(docker compose build:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose run:*)",
      "Bash(gh api:*)",
      "Bash(gh auth status)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(specify check)",
      "Bash(tofu fmt -check:*)",
      "Bash(tofu plan:*)",
      "Bash(tofu validate:*)",
      "Bash(uv run lint-imports:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(uv run task check-money)",
      "Bash(uv run task lint)",
      "Bash(uv run task test:*)",
      "Bash(uv sync --locked)",
      "Bash(uv sync)",
      "Bash(uv tree:*)"
    ],
    "ask": [
      "Bash(docker compose down -v:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose up:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(git push:*)",
      "Bash(tofu apply:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv run task migrate)"
    ],
    "deny": [
      "Bash(uv pip install:*)",
      "Bash(pip install:*)",
      "Bash(poetry:*)",
      "Bash(terraform:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfvars)"
    ]
  }
}
