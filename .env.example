# CFOKit configuration. Copy to .env and fill in.
#
# This is the complete surface the application reads (ADR-0003). There is deliberately
# no variable selecting a cloud, a region, or a provider. Adding one requires an ADR,
# because infra/README.md is the portability contract (ADR-0016).

# --- Service -----------------------------------------------------------------
# Postgres connection string. The only storage backend (ADR-0002).
DATABASE_URL=postgresql://cfokit:cfokit@localhost:5432/cfokit

# Authoritative for anything the service says about itself. Never derived from
# request headers — behind a proxy or tunnel they lie (ADR-0003).
PUBLIC_BASE_URL=http://localhost:8080

# OAuth 2.1 issuer. Swappable; no issuer-specific code exists anywhere (ADR-0019).
AUTH_ISSUER_URL=http://localhost:4444
AUTH_AUDIENCE=cfokit-ledger

# Optional.
# LOG_LEVEL=info
# PORT=8080

# --- Separate components only (ADR-0024) -------------------------------------
# Where the API is reachable *from the component*. Not the same as PUBLIC_BASE_URL.
# CFOKIT_API_URL=http://localhost:8080
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
