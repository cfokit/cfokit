{
  "name": "cfokit-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "lint": "eslint . && prettier --check . && tsc -p e2e",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "sample-export": "node e2e/sample-export.ts",
    "read-fixture": "vitest run src/quickbooks/fixture.test.ts --update",
    "theme": "vitest run design/theme.test.ts --update",
    "design-system": "node design/publish/build.mjs && node design/publish/check.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@assistant-ui/react": "0.15.31",
    "@assistant-ui/react-ag-ui": "0.1.0",
    "@assistant-ui/react-markdown": "0.14.24",
    "@tanstack/react-router": "1.170.46",
    "big.js": "7.0.1",
    "comlink": "4.4.2",
    "keycloakify": "11.16.4",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-oidc-context": "3.3.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/big.js": "7.0.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react-18": "npm:react@18.3.1",
    "react-dom-18": "npm:react-dom@18.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
