# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# The web client (ADR-0054). `dist/` above already covers its static build.
node_modules/
dist_keycloak/
dist-design-system/
# Keycloak's own login resources, copied in by the Keycloakify plugin for `pnpm dev`.
web/public/keycloakify-dev-resources/

# uv / virtualenvs
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environment — never commit secret values (ADR-0016)
.env
.env.*
!.env.example

# OpenTofu — state contains secrets in plaintext (ADR-0016)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl is deliberately NOT ignored — provider pins are committed.
crash.log
crash.*.log

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Claude Code local overrides (project settings.json IS committed)
.claude/settings.local.json

# A local compose overlay naming paths on one machine — where an export lives, where reports
# go. Deliberately not auto-applied and deliberately not shared: `compose.yaml` states what
# every deployment gets, and a path that exists on one laptop is not that (ADR-0018).
compose.*.yaml
!compose.dev.yaml

# Local TLS material generated by the compose `tls` step (infra/tls/generate.py).
.local/

# Agent worktrees, each a checkout of its own branch
.claude/worktrees/
