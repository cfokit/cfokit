{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "description": "Every error, on both adapters, in this shape.\n\n`code` is the contract; `message` is not and may be reworded at will (ADR-0015).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "PostingModel": {
        "description": "One side of a transaction. Positive is a debit, negative a credit.",
        "properties": {
          "account_id": {
            "description": "The account this posting hits.",
            "title": "Account Id",
            "type": "string"
          },
          "amount": {
            "description": "Signed decimal string. Positive debits the account.",
            "examples": [
              "100.00",
              "-1250.5000000000"
            ],
            "title": "Amount",
            "type": "string"
          },
          "commodity": {
            "description": "The unit the amount is denominated in, e.g. USD.",
            "title": "Commodity",
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "amount",
          "commodity"
        ],
        "title": "PostingModel",
        "type": "object"
      },
      "RecordTransactionRequest": {
        "description": "Record a transaction, as a draft or posted straight through.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "post": {
            "default": false,
            "description": "Post immediately. A draft is freely editable; posting is the point of no return.",
            "title": "Post",
            "type": "boolean"
          },
          "postings": {
            "description": "Every side of the transaction. Must sum to zero per commodity to post.",
            "items": {
              "$ref": "#/components/schemas/PostingModel"
            },
            "title": "Postings",
            "type": "array"
          },
          "transaction_date": {
            "description": "When the event economically occurred. Not when it was recorded — that is server-assigned and cannot be supplied.",
            "format": "date",
            "title": "Transaction Date",
            "type": "string"
          }
        },
        "required": [
          "transaction_date",
          "postings"
        ],
        "title": "RecordTransactionRequest",
        "type": "object"
      },
      "TransactionResponse": {
        "description": "A transaction as the books hold it.",
        "properties": {
          "acting_for_principal_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acting For Principal Id"
          },
          "actor_class": {
            "title": "Actor Class",
            "type": "string"
          },
          "actor_principal_id": {
            "title": "Actor Principal Id",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "entry_kind": {
            "title": "Entry Kind",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "postings": {
            "items": {
              "$ref": "#/components/schemas/PostingModel"
            },
            "title": "Postings",
            "type": "array"
          },
          "reverses_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reverses Id"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "transaction_date": {
            "format": "date",
            "title": "Transaction Date",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "transaction_date",
          "description",
          "reverses_id",
          "entry_kind",
          "actor_principal_id",
          "actor_class",
          "acting_for_principal_id",
          "postings"
        ],
        "title": "TransactionResponse",
        "type": "object"
      },
      "WriteResponse": {
        "description": "What a write produced.",
        "properties": {
          "replayed": {
            "description": "True when this request replayed an earlier one with the same idempotency key. Nothing was booked a second time.",
            "title": "Replayed",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "transaction_id": {
            "title": "Transaction Id",
            "type": "string"
          }
        },
        "required": [
          "transaction_id",
          "status",
          "replayed"
        ],
        "title": "WriteResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Multi-tenant double-entry accounting engine.",
    "title": "CFOKit Ledger",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/entities/{entity_id}/transactions": {
      "post": {
        "description": "Record a transaction as a draft, or post it straight through.\n\nRequires an `Idempotency-Key` header. Replaying one returns the original result and\nbooks nothing further (ADR-0029).",
        "operationId": "record_entities__entity_id__transactions_post",
        "parameters": [
          {
            "in": "path",
            "name": "entity_id",
            "required": true,
            "schema": {
              "title": "Entity Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "default": "",
              "title": "Idempotency-Key",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordTransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Record a transaction",
        "tags": [
          "transactions"
        ]
      }
    },
    "/entities/{entity_id}/transactions/{transaction_id}": {
      "get": {
        "description": "Read a transaction and its postings.\n\nA transaction belonging to another entity is reported as not found rather than as\nforbidden: row-level security makes absent and invisible the same answer, and\ndistinguishing them would leak the other entity's existence (`NFR-04`).",
        "operationId": "read_entities__entity_id__transactions__transaction_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "entity_id",
            "required": true,
