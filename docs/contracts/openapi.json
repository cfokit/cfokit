    "/entities/{entity_id}/transactions/{transaction_id}/reversal": {
      "post": {
        "description": "Correct a posted transaction by reversing it, leaving both visible (`LED-08`).\n\nThere is deliberately no endpoint that edits or deletes a posted transaction. The\nschema refuses both, and offering the route would be offering a way to find out.\n\n`original_period_closed` is hardcoded false because period close does not exist yet\n(ADR-0030). When it does, this is where the reopen question is asked.",
        "operationId": "reverse_entities__entity_id__transactions__transaction_id__reversal_post",
        "parameters": [
          {
            "in": "path",
            "name": "transaction_id",
            "required": true,
            "schema": {
              "title": "Transaction Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "entity_id",
            "required": true,
            "schema": {
              "title": "Entity Id",
              "type": "string"
            }
          },
          {
            "in": "query",
