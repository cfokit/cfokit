{
  "components": {
    "schemas": {
      "CreateEntityRequest": {
        "description": "Everything an entity declares at creation, all of it required.\n\n`LED-14` and `LED-15` say the basis, the fiscal year end and the functional currency have\nno undeclared state, and `PLT-08` says the same for the time zone. There are no defaults\nhere for that reason: a default would be an undeclared state wearing a value.",
        "properties": {
          "accounting_basis": {
            "description": "Fixes what every report defaults to. A property of the entity, not a per-report option, and never a posting rule (ADR-0037).",
            "enum": [
              "cash",
              "accrual"
            ],
            "title": "Accounting Basis",
            "type": "string"
          },
          "administrator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The entity's first administrator. Defaults to the creating principal; an entity never exists without one (IAM-05).",
            "title": "Administrator"
          },
          "fiscal_year_end_day": {
            "maximum": 31.0,
            "minimum": 1.0,
            "title": "Fiscal Year End Day",
            "type": "integer"
          },
          "fiscal_year_end_month": {
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Fiscal Year End Month",
            "type": "integer"
          },
          "functional_currency": {
            "description": "Amounts in any other commodity are refused until LED-16 activates.",
            "title": "Functional Currency",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "description": "Stable identifier, unique in this deployment.",
            "title": "Slug",
            "type": "string"
          },
          "time_zone": {
            "description": "Period boundaries are determined in it (PLT-08).",
            "title": "Time Zone",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name",
          "accounting_basis",
          "fiscal_year_end_month",
          "fiscal_year_end_day",
          "functional_currency",
          "time_zone"
        ],
        "title": "CreateEntityRequest",
        "type": "object"
      },
      "EntityCreatedResponse": {
        "properties": {
          "administrator_grant_id": {
            "title": "Administrator Grant Id",
            "type": "string"
          },
          "entity_id": {
            "title": "Entity Id",
            "type": "string"
          }
        },
        "required": [
          "entity_id",
          "administrator_grant_id"
        ],
        "title": "EntityCreatedResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Every error, on both adapters, in this shape.\n\n`code` is the contract; `message` is not and may be reworded at will (ADR-0015).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GrantResponse": {
        "properties": {
          "grant_id": {
            "title": "Grant Id",
            "type": "string"
          }
        },
        "required": [
          "grant_id"
        ],
        "title": "GrantResponse",
        "type": "object"
      },
      "GrantRoleRequest": {
        "description": "Grant a role in this entity. Administrative only (IAM-03).",
        "properties": {
          "lapses_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the role lapses without anyone acting (IAM-09). Null is open-ended.",
            "title": "Lapses At"
          },
          "principal_id": {
            "title": "Principal Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "reader",
              "recorder",
              "poster",
              "administrator"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "principal_id",
          "role"
        ],
        "title": "GrantRoleRequest",
        "type": "object"
      },
      "PostingModel": {
        "description": "One side of a transaction. Positive is a debit, negative a credit.",
        "properties": {
          "account_id": {
            "description": "The account this posting hits.",
            "title": "Account Id",
            "type": "string"
          },
          "amount": {
            "description": "Signed decimal string. Positive debits the account.",
            "examples": [
              "100.00",
              "-1250.5000000000"
            ],
            "title": "Amount",
            "type": "string"
          },
          "commodity": {
            "description": "The unit the amount is denominated in, e.g. USD.",
            "title": "Commodity",
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "amount",
          "commodity"
        ],
        "title": "PostingModel",
        "type": "object"
      },
      "RecordTransactionRequest": {
        "description": "Record a transaction, as a draft or posted straight through.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "post": {
            "default": false,
            "description": "Post immediately. A draft is freely editable; posting is the point of no return.",
            "title": "Post",
            "type": "boolean"
          },
          "postings": {
            "description": "Every side of the transaction. Must sum to zero per commodity to post.",
            "items": {
              "$ref": "#/components/schemas/PostingModel"
            },
            "title": "Postings",
            "type": "array"
          },
          "transaction_date": {
            "description": "When the event economically occurred. Not when it was recorded — that is server-assigned and cannot be supplied.",
            "format": "date",
            "title": "Transaction Date",
            "type": "string"
          }
        },
        "required": [
          "transaction_date",
          "postings"
        ],
        "title": "RecordTransactionRequest",
        "type": "object"
      },
      "TransactionResponse": {
        "description": "A transaction as the books hold it.",
        "properties": {
          "acting_for_principal_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acting For Principal Id"
          },
          "actor_class": {
            "title": "Actor Class",
            "type": "string"
          },
          "actor_principal_id": {
            "title": "Actor Principal Id",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "entry_kind": {
            "title": "Entry Kind",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "postings": {
            "items": {
              "$ref": "#/components/schemas/PostingModel"
            },
            "title": "Postings",
            "type": "array"
          },
          "reverses_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reverses Id"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "transaction_date": {
            "format": "date",
            "title": "Transaction Date",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "transaction_date",
          "description",
          "reverses_id",
          "entry_kind",
          "actor_principal_id",
          "actor_class",
          "acting_for_principal_id",
          "postings"
        ],
        "title": "TransactionResponse",
        "type": "object"
      },
      "WriteResponse": {
        "description": "What a write produced.",
        "properties": {
          "replayed": {
            "description": "True when this request replayed an earlier one with the same idempotency key. Nothing was booked a second time.",
            "title": "Replayed",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "transaction_id": {
            "title": "Transaction Id",
            "type": "string"
          }
        },
        "required": [
          "transaction_id",
          "status",
          "replayed"
        ],
        "title": "WriteResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Multi-tenant double-entry accounting engine.",
    "title": "CFOKit Ledger",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/entities": {
      "post": {
        "description": "Requires a deployment-scoped administrative role (`IAM-18`, ADR-0038).\n\nThe entity and its first administrator are written in one transaction, or neither is\n(`IAM-05`).",
        "operationId": "create_entities_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEntityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityCreatedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Create an entity and assign its first administrator",
        "tags": [
          "administration"
        ]
      }
    },
