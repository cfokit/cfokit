    "/healthz": {
      "get": {
        "description": "Liveness only. Deliberately touches nothing.\n\nIf this checked the database, a database blip would restart every healthy\ncontainer — turning a recoverable outage into a rolling one.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "operations"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Database reachable, and migrations current.\n\nReturns 503 when not ready, so a rollout stops rather than serving traffic\nagainst a schema older than the code.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Readyz Readyz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "operations"
        ]
      }
