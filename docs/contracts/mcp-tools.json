    "name": "account_statement_agreement"
  },
  {
    "description": "Approve a rule, an edit to one, or its retirement. A person's own act: a delegated session is refused. Pass rule_id to supersede an existing rule; the prior version stays, so what it already coded is untouched.",
    "inputSchema": {
      "$defs": {
        "Field": {
          "description": "What a predicate may look at. A closed set, and the second half of the enforcement —\nmigration 0012's `predicate_is_well_typed` is the first, so the two must agree and a test\nasserts it (ADR-0036 § 5: an expected value comes from a second enforcement point).\n\nAdding one is a migration and a code change together. That is the deliberate cost of a\nclosed set, paid to keep clear of ADR-0012's custom-query-language gate (ADR-0045).",
          "enum": [
            "payee",
            "description",
            "amount",
            "direction",
            "commodity",
            "source_kind",
            "source_account_id"
          ],
          "title": "Field",
          "type": "string"
        },
        "Operator": {
          "description": "How a predicate compares. Closed, for the same reason `Field` is.",
          "enum": [
            "equals",
            "not_equals",
            "contains",
            "starts_with",
            "ends_with",
            "greater_than",
            "greater_or_equal",
            "less_than",
            "less_or_equal"
          ],
          "title": "Operator",
          "type": "string"
        },
        "PredicateArgument": {
          "properties": {
            "field": {
              "$ref": "#/$defs/Field"
            },
            "operator": {
              "$ref": "#/$defs/Operator"
            },
            "value": {
              "title": "Value",
              "type": "string"
            }
          },
          "required": [
            "field",
            "operator",
            "value"
          ],
          "title": "PredicateArgument",
          "type": "object"
        }
      },
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "precedence": {
          "title": "Precedence",
          "type": "integer"
        },
        "predicates": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PredicateArgument"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicates"
        },
        "retire": {
          "default": false,
          "title": "Retire",
          "type": "boolean"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        }
      },
      "required": [
        "entity_id",
        "label",
        "precedence"
      ],
      "title": "approve_toolArguments",
      "type": "object"
    },
    "name": "approve_assignment_rule"
  },
